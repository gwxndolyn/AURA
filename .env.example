# ---- Database ----
# Default: local SQLite file (zero-config, works out of the box).
# For PostgreSQL (via docker-compose), use:
#   postgresql://aura:aura@localhost:5432/aura?schema=public
# and set the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# ---- Redis (optional) ----
# AURA runs with an in-memory event bus by default. Redis is only needed for
# multi-process event streaming / queues. Leave blank to use in-memory mode.
REDIS_URL=""

# ---- Anthropic Claude API ----
# If omitted, AURA runs in SIMULATION mode: agents use a deterministic local
# reasoning engine so the entire app is fully functional offline. Provide a key
# to get real Claude-powered agents.
ANTHROPIC_API_KEY=""

# Model routing. Override to taste.
CLAUDE_MODEL_FAST="claude-haiku-4-5-20251001"
CLAUDE_MODEL_STANDARD="claude-sonnet-5-5"
CLAUDE_MODEL_REASONING="claude-opus-5-5"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Session signing secret (>= 16 chars). REQUIRED in production — the app refuses
# to sign sessions without it. In development a fixed insecure default is used.
AUTH_SECRET=""

# If this repo is inside a cloud-synced folder (OneDrive/iCloud/Dropbox), point
# the Next.js build output somewhere outside it to avoid sync thrash. Optional;
# defaults to the normal ".next".
# AURA_DIST_DIR="/tmp/aura-next"

# ---- Execution sandbox (Docker) ----
# If Docker is running, agents' generated code and tests execute for real inside
# a locked-down container (no network, memory/CPU limits). If Docker is absent,
# AURA falls back to a simulated result so it still works. These are optional.
AURA_SANDBOX_IMAGE="node:20-alpine"
AURA_SANDBOX_MEMORY="256m"
AURA_SANDBOX_CPUS="1"
AURA_SANDBOX_TIMEOUT_MS="20000"

# ---- Product factory: git repositories ----
# AURA keeps one real git repository per product (bare repo; agents commit
# verified work to isolated aura/* branches, never the default branch).
# Defaults to <os tmpdir>/aura-git — set a durable path in production.
AURA_GIT_ROOT=""
# GitHub/GitLab publication: create a repo-scoped token, put it in a server env
# var, and enter the env var NAME (not the token) when connecting a repository.
# Example (names are up to you):
#   AURA_GITHUB_TOKEN="github_pat_..."     # fine-grained, contents+pull requests on ONE repo
#   AURA_GITHUB_WEBHOOK_SECRET="..."      # webhook secret for that repository

# ---- Model provider (required for planning and engineering runs) ----
# ANTHROPIC_API_KEY above is REQUIRED outside the simulation lab: without it
# AURA reports "AI not configured" instead of producing any output.
# Optional gateway / proxy for the Anthropic API:
ANTHROPIC_BASE_URL=""
AURA_MODEL_TIMEOUT_MS="120000"
AURA_AGENT_MAX_TURNS="40"

# ---- Background jobs ----
# inline (default): the worker runs inside the web server process.
# external: run `npm run worker` separately (recommended with >1 web instance).
AURA_WORKER="inline"
AURA_WORKER_CONCURRENCY="2"
AURA_JOB_LEASE_MS="120000"
AURA_JOB_BACKOFF_MS="5000"

# ---- Builder (engineering runs) ----
# Working trees for runs (removed after each run). Use a fast local disk.
AURA_WORK_ROOT=""
AURA_INSTALL_TIMEOUT_MS="240000"
AURA_COMMAND_TIMEOUT_MS="120000"
AURA_SANDBOX_INSTALL_MEMORY="1g"

# ---- Billing (Stripe) ----
# Test mode: use sk_test_... keys. Prices must match src/lib/billing/plans.ts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""

# ---- GitHub App ----
# Create a GitHub App (Contents: R/W, Pull requests: R/W, Metadata: R, Checks: R),
# set its Setup URL to <APP_URL>/api/github/callback, and paste its private key.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""

# ---- Email (password reset, billing notices) ----
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- Public site ----
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SECURITY_EMAIL=""

# ---- Simulation lab (legacy company simulator; off in production) ----
AURA_SIMULATION_LAB=""
NEXT_PUBLIC_AURA_SIMULATION_LAB=""
